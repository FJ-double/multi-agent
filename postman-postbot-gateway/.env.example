# 必填：你的 Postman Workspace UUID
POSTMAN_WORKSPACE_ID=

# 可选：启动时指定 accounts 目录中的账号 JSON 文件名。
# 留空时会按文件名排序选择第一个。
POSTMAN_ACCOUNT=

# 可选：开启账号额度自动切换。
# 当当前账号额度用尽或被锁定时，自动切换到下一个额度可用的账号。
# 默认关闭：POSTMAN_AUTO_SWITCH_ACCOUNT=0
POSTMAN_AUTO_SWITCH_ACCOUNT=1

# 可选：账号额度检查缓存时长（毫秒）。
# 缓存命中时不会重复请求 Postman /config 接口。
# 默认 15000 毫秒。
POSTMAN_QUOTA_REFRESH_MS=15000

# 可选：调试日志
POSTMAN_GATEWAY_DEBUG=0
